<% content_for :title, "New Post" %>

<div class="editor-container">
  <%= form_with(model: @post, data: { controller: "word-counter autogrow" }) do |form| %>
    <% if @post.errors.any? %>
      <div class="flash alert">
        <h2><%= pluralize(@post.errors.count, "error") %> prohibited this post from being saved:</h2>
        <ul>
          <% @post.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="editor-header">
      <div class="word-count" data-word-counter-target="counter">0/500</div>
    </div>

    <%= form.text_area :content,
      class: "content-editor",
      placeholder: "Start typing. Aim for 500 words a day, that's like two novels a year.",
      autofocus: true,
      data: {
        word_counter_target: "textarea",
        autogrow_target: "textarea",
        action: "input->word-counter#updateWordCount input->autogrow#resize"
      } %>

    <div class="editor-footer">
      <%= form.submit "Save", class: "btn" %>
    </div>
  <% end %>
</div>
